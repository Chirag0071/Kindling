# Database
DATABASE_URL=postgresql://dating_app:dating_app_pw@localhost:5432/dating_app

# Auth
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Media storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces...)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=dating-app-media
# Only needed for non-AWS providers (leave blank for real AWS S3):
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=

# App
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
